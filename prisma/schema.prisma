// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
}

model Formula {
  id                 Int      @id @default(autoincrement())
  name               String
  category           String
  actualComposition  String
  prepInstruction    String?
  createdAt          DateTime @default(now())
}
model Patient {
  id        Int      @id @default(autoincrement())
  patientId String   @unique
  name      String
  phone     String
  cnic      String?
  age       Int?
  gender    String?
  createdAt DateTime @default(now())
}

model Prescription {
  id             Int       @id @default(autoincrement())
  prescriptionId String    @unique
  patientName    String
  patientPhone   String
  doctorName     String
  complaint      String
  formulaNames   String
  status         String    @default("pending")
  nextVisit      DateTime?
  createdAt      DateTime  @default(now())
}

model Dispensing {
  id              Int      @id @default(autoincrement())
  tenantId        String
  patientName     String
  phone           String
  cnic            String?
  formulaNames    String
  prepInstruction String
  status          String   @default("Pending")
  createdAt       DateTime @default(now())
}