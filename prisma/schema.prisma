generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
}

model Formula {
  id                 Int      @id @default(autoincrement())
  name               String
  category           String
  actualComposition  String
  prepInstruction    String?
  createdAt          DateTime @default(now())
}

model Patient {
  id        Int      @id @default(autoincrement())
  patientId String   @unique
  name      String
  phone     String
  cnic      String?  @unique
  age       Int?
  gender    String?
  createdAt DateTime @default(now())
}

model Prescription {
  id              Int       @id @default(autoincrement())
  patientId       String
  patientName     String
  phone           String
  cnic            String?
  age             Int?
  gender          String?
  doctorName      String
  complaint       String?
  formulaName     String?
  customFormula   String?
  prepInstruction String
  nextVisit       DateTime?
  status          String    @default("Pending")
  patientType     String    @default("new")
  createdAt       DateTime  @default(now())
}

model Dispensing {
  id              Int      @id @default(autoincrement())
  tenantId        String
  patientName     String
  phone           String
  cnic            String?
  formulaNames    String
  prepInstruction String
  status          String   @default("Pending")
  createdAt       DateTime @default(now())
}